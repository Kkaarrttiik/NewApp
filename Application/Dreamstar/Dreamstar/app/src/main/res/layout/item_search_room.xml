<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data></data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="15dp"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/ivRoom"
                android:layout_width="52sp"
                android:layout_height="52sp"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toStartOf="@id/btnJoin"
                android:layout_toEndOf="@id/ivRoom">

                <TextView
                    android:id="@+id/tvRoomName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/airbnbcereal_w_bd"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:text="Room Name" />

                <TextView
                    android:id="@+id/tvOwnerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvRoomName"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/airbnbcereal_w_lt"
                    android:singleLine="true"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp"
                    android:text="Owner" />

                <TextView
                    android:id="@+id/tvViewers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvOwnerName"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/airbnbcereal_w_lt"
                    android:textColor="#60FFFFFF"
                    android:textSize="11sp"
                    android:drawableStart="@drawable/icon_eye"
                    android:drawablePadding="3dp"
                    android:gravity="center_vertical"
                    android:text="0" />

            </RelativeLayout>

            <TextView
                android:id="@+id/btnJoin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="5dp"
                android:background="@drawable/btn_bg"
                android:fontFamily="@font/airbnbcereal_w_md"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Join"
                android:textColor="@color/white"
                android:textSize="12sp" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="15dp"
            android:background="#30FFFFFF" />

    </LinearLayout>
</layout>
